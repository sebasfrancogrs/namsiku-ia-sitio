# Clave de API de Anthropic (Claude) — usada solo en /api/chat, del lado servidor.
# Nunca exponer al cliente (no usar prefijo NEXT_PUBLIC_).
ANTHROPIC_API_KEY=

# URL del webhook de n8n que recibe los envíos del formulario de contacto.
# Usada solo en /api/contacto, del lado servidor.
N8N_CONTACT_WEBHOOK_URL=
