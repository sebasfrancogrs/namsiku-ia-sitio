# Proveedor de IA para el chatbot: "anthropic" (default) u "openrouter".
# Cambiar de proveedor no requiere tocar código, solo estas variables.
AI_PROVIDER=anthropic

# --- Anthropic (Claude) — requerido si AI_PROVIDER=anthropic ---
# Nunca se expone al cliente, se usa solo en /api/chat.
ANTHROPIC_API_KEY=
# Opcional — default: claude-opus-5
ANTHROPIC_MODEL=

# --- OpenRouter — requerido si AI_PROVIDER=openrouter ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Slug del modelo en OpenRouter, ej: "anthropic/claude-opus-5", "openai/gpt-4.1",
# "google/gemini-2.5-pro". Ver catálogo completo en https://openrouter.ai/models
OPENROUTER_MODEL=

# URL del webhook de n8n que recibe los envíos del formulario de contacto.
# Usada solo en /api/contacto, del lado servidor.
N8N_CONTACT_WEBHOOK_URL=
